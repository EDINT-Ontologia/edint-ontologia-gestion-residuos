@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix waste: <https://w3id.org/def/medioambiente/residuos#> .
@prefix wastekos: <https://w3id.org/kos/medioambiente/residuos/> .
@prefix treatmentprocess: <https://w3id.org/kos/medioambiente/residuos/TreatmentProcess/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

wastekos:TreatmentProcess a skos:ConceptScheme ;
    dct:issued "2026-04-21"^^xsd:date ;
    dct:modified "2026-04-24"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Esquema de conceptos para los procesos de tratamiento aplicados en centros de gestión de residuos."@es ;
    rdfs:comment "Concept scheme for the treatment processes used in waste management facilities."@en ;
    rdfs:label "Procesos de tratamiento"@es ;
    rdfs:label "Treatment processes"@en ;
    dct:title "Esquema de conceptos agrupando procesos de tratamiento de residuos"@es ;
    dct:title "Concept scheme grouping waste treatment processes"@en ;
    skos:note "Valores extraídos del conjunto de datos de centros de gestión de residuos."@es ;
    skos:note "Data extracted from waste management datasets."@en .

#################################################################
#
#    Concepts
#
#################################################################

treatmentprocess:ClasificacionDeResiduosNoPeligrosos a skos:Concept ;
    skos:inScheme wastekos:TreatmentProcess ;
    skos:prefLabel "Clasificación de residuos no peligrosos"@es ;
    skos:prefLabel "Classification of non-hazardous waste"@en .

treatmentprocess:HidrocarburosQueContienenAcidos a skos:Concept ;
    skos:inScheme wastekos:TreatmentProcess ;
    skos:prefLabel "Hidrocarburos que contienen ácidos"@es ;
    skos:prefLabel "Hydrocarbons containing acids"@en .

treatmentprocess:ArcillasDeFiltracionUsadas a skos:Concept ;
    skos:inScheme wastekos:TreatmentProcess ;
    skos:prefLabel "Arcillas de filtración usadas"@es ;
    skos:prefLabel "Used filtration clays"@en .