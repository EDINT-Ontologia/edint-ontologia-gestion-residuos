        <rdfs:label>Mobile Collection Point</rdfs:label>
    </owl:Class>
    


    <!-- https://edint.es/def/gestion-residuos#PermanentCollectionPoint -->

    <owl:Class rdf:about="https://edint.es/def/gestion-residuos#PermanentCollectionPoint">
        <rdfs:subClassOf rdf:resource="https://edint.es/def/gestion-residuos#CollectionPoint"/>
        <rdfs:label>Permanent Collection Point</rdfs:label>
    </owl:Class>
    


    <!-- https://edint.es/def/gestion-residuos#WasteContainer -->

    <owl:Class rdf:about="https://edint.es/def/gestion-residuos#WasteContainer">
        <rdfs:subClassOf rdf:resource="https://edint.es/def/gestion-residuos#WasteFacility"/>
        <rdfs:comment xml:lang="es">Contenedor de residuos</rdfs:comment>
        <rdfs:comment xml:lang="es">Es un recipiente usado para almacenamiento temporal de basuras que está normalmente hecho de metal o plástico.</rdfs:comment>
        <rdfs:comment xml:lang="en">It is a container used for the temporary storage of waste, typically made of metal or plastic.</rdfs:comment>
        <rdfs:label xml:lang="en">Waste Container</rdfs:label>
    </owl:Class>
    


    <!-- https://edint.es/def/gestion-residuos#WasteFacility -->

    <owl:Class rdf:about="https://edint.es/def/gestion-residuos#WasteFacility">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="https://edint.es/def/infraestructura#Facility"/>
        <rdfs:comment xml:lang="en">A facility intended for the collection, treatment, transport, or storage of garbage and other waste.</rdfs:comment>
        <rdfs:comment xml:lang="es">Equipamiento destinado a la  recogida, tratamiento, transporte o almacenamiento de la basura y otros desechos.</rdfs:comment>
        <rdfs:label xml:lang="es">Equipamiento de Residuos</rdfs:label>
        <rdfs:label xml:lang="en">Waste Facility</rdfs:label>
    </owl:Class>
    


    <!-- https://edint.es/def/gestion-residuos#WasteManagementFacility -->

    <owl:Class rdf:about="https://edint.es/def/gestion-residuos#WasteManagementFacility">
        <rdfs:subClassOf rdf:resource="https://edint.es/def/gestion-residuos#WasteFacility"/>
        <rdfs:comment xml:lang="en">A designated site or structure equipped to handle, process, treat, store, or dispose of various types of waste. For example, a landfill or a recycling and processing center.</rdfs:comment>
        <rdfs:comment xml:lang="es">Equipamiento para la gestión de residuos</rdfs:comment>
        <rdfs:comment xml:lang="es">Un sitio o estructura designada y equipada para gestionar, procesar, tratar, almacenar o eliminar diversos tipos de residuos. Por ejemplo, un vertedero o un centro de reciclaje y procesamiento.</rdfs:comment>
        <rdfs:label xml:lang="en">Waste Management Facility</rdfs:label>
    </owl:Class>
    


