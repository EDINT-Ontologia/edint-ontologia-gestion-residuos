    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:label>has geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:label>in scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/gestion-residuos#acceptsWasteType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/gestion-residuos#acceptsWasteType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://edint.es/def/gestion-residuos#CollectionPoint"/>
                    <rdf:Description rdf:about="https://edint.es/def/gestion-residuos#WasteContainer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/WasteType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A container or a collection point accepts specific types of waste.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un contenedor o un punto limpio aceptan determinados tipos de residuos.</rdfs:comment>
        <rdfs:label xml:lang="en">accepts waste type</rdfs:label>
        <rdfs:label xml:lang="es">acepta tipo de residuo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/gestion-residuos#belongsTo -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/gestion-residuos#belongsTo">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteFacility"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio"/>
                    <rdf:Description rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito"/>
                    <rdf:Description rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A waste management facility belongs to a neighborhood, district, or municipality.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un equipamiento para residuos pertenece a un barrio, distrito o municipio.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to</rdfs:label>
        <rdfs:label xml:lang="es">pertenece a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/gestion-residuos#hasManagementScope -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/gestion-residuos#hasManagementScope">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteManagementFacility"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/WasteManagementScope"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Alcance de gestión asociados a centros de gestión de residuos, por ejemplo el almacenamiento de residuos metálicos de plomo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Management scope associated with waste management facilities, for example, the storage of lead-based metal waste.</rdfs:comment>
        <rdfs:label xml:lang="en">has management scope</rdfs:label>
        <rdfs:label xml:lang="es">tiene ámbito de gestión</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/gestion-residuos#hasTreatmentProcess -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/gestion-residuos#hasTreatmentProcess">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteManagementFacility"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/WasteTreatmentProcess"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A set of physical, chemical, or biological operations designed to modify the characteristics of waste in order to reduce its hazardousness, recover the materials it contains, or facilitate its safe disposal.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto de operaciones físicas, químicas o biológicas destinadas a modificar las características de los desechos para reducir su peligrosidad, aprovechar los materiales que contienen o facilitar su eliminación segura.</rdfs:comment>
        <rdfs:label xml:lang="en">has treatment process</rdfs:label>
        <rdfs:label xml:lang="es">tiene proceso de tratamiento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/gestion-residuos#managesWasteType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/gestion-residuos#managesWasteType">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteManagementFacility"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/WasteType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relación entre el equipamiento para gestión de residuos y el tipo de residuos que gestiona.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between waste management equipment and the type of waste managed.</rdfs:comment>
        <rdfs:comment xml:lang="es">gestiona tipo de residuo</rdfs:comment>
        <rdfs:label xml:lang="en">manages waste type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/address -->

    <owl:ObjectProperty rdf:about="https://schema.org/address">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteFacility"/>
        <rdfs:range rdf:resource="https://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal"/>
        <rdfs:label>address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/contactPoint -->

    <owl:ObjectProperty rdf:about="https://schema.org/contactPoint">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://edint.es/def/gestion-residuos#CollectionPoint"/>
                    <rdf:Description rdf:about="https://edint.es/def/gestion-residuos#WasteManagementFacility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://schema.org/ContactPoint"/>
        <rdfs:label>contact point</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAProvincia -->

    <owl:ObjectProperty rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAProvincia">
        <rdfs:domain rdf:resource="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
        <rdfs:range rdf:resource="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia"/>
        <rdfs:label>pertenece a provincia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAlMunicipio -->

    <owl:ObjectProperty rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAlMunicipio">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio"/>
                    <rdf:Description rdf:about="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
        <rdfs:label>pertenece al municipio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/identifier -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#CollectionPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#asWKT -->

    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
        <rdfs:label>as wkt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/gestion-residuos#admissibleWasteURL -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/gestion-residuos#admissibleWasteURL">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#MobileCollectionPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">URL de residuos admisibles.</rdfs:label>
        <rdfs:label xml:lang="en">admissible waste url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/gestion-residuos#containerBatch -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/gestion-residuos#containerBatch">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteContainer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">A specific, grouped quantity of waste units.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una cantidad específica y agrupada de unidades de residuos.</rdfs:comment>
        <rdfs:label xml:lang="en">container batch</rdfs:label>
        <rdfs:label xml:lang="es">grupo de contenedores</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/gestion-residuos#containerLocationCode -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/gestion-residuos#containerLocationCode">
        <rdfs:domain rdf:resource="https://edint.es/def/gestion-residuos#WasteContainer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador específico utilizado en los sistemas de gestión de residuos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specific identifier used in waste management systems.</rdfs:comment>
        <rdfs:label xml:lang="en">container location code</rdfs:label>
