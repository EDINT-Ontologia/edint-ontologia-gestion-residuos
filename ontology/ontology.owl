    <!-- https://edint.es/def/gestion-residuos#CollectionPoint -->

    <owl:Class rdf:about="https://edint.es/def/gestion-residuos#CollectionPoint">
        <rdfs:subClassOf rdf:resource="https://edint.es/def/gestion-residuos#WasteFacility"/>
        <rdfs:comment xml:lang="es">Es una instalación donde se recogen y almacenan temporalmente y de forma gratuita los residuos domésticos que, por su gran volumen o peligrosidad, no deben arrojarse a la bolsa de la basura ni depositarse en los contenedores de la calle.</rdfs:comment>
        <rdfs:comment xml:lang="en">It is a facility where household waste is collected and temporarily stored free of charge—waste that, due to its large volume or hazardous nature, should not be thrown into regular trash bags or deposited in street-side bins.</rdfs:comment>
        <rdfs:comment xml:lang="de">Punto limpio</rdfs:comment>
        <rdfs:label xml:lang="en">Collection Point</rdfs:label>
    </owl:Class>
    


    <!-- https://edint.es/def/gestion-residuos#MobileCollectionPoint -->

    <owl:Class rdf:about="https://edint.es/def/gestion-residuos#MobileCollectionPoint">
