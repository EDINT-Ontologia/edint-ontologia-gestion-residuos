<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/gestion-residuos#"
     xml:base="https://edint.es/def/gestion-residuos"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="https://schema.org/"
     xmlns:widoco="https://w3id.org/widoco/vocab#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://edint.es/def/gestion-residuos#">
        <owl:versionIRI rdf:resource="https://edint.es/def/gestion-residuos/0.1.1"/>
        <dcterms:abstract xml:lang="es">El propósito de esta ontología es el de proporcionar un vocabulario común para la representación de los elementos asociados a la gestión de residuos, incluyendo su tipología, su depósito en contenedores y puntos de recogida, su tratamiento en instalaciones y su localización. Su alcance se limita a los datos de carácter administrativo y estructural: quedan fuera del modelo los aspectos relativos a la gestión operativa o al funcionamiento detallado de los servicios, que podrían ser incorporados en futuras extensiones de la ontología.</dcterms:abstract>
        <dcterms:abstract xml:lang="en">The purpose of this ontology is to provide a common vocabulary for representing the elements associated with waste management, including waste types, their deposit in containers and collection points, their treatment in facilities and their location. Its scope is limited to administrative and structural data; aspects related to operational management or the detailed operation of the services fall outside the model, although they could be addressed through future extensions of the ontology.</dcterms:abstract>
        <dcterms:bibliographicCitation xml:lang="en">EDINT Waste Management Ontology. EDINT. Revision: v0.1.1.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation xml:lang="es">Ontología EDINT de Gestión de Residuos. EDINT. Revisión: v0.1.1.</dcterms:bibliographicCitation>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</dcterms:created>
        <dcterms:creator>
            <rdf:Description>
                <foaf:name>Laura Gilgado Romero</foaf:name>
                <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
            </rdf:Description>
        </dcterms:creator>
        <dcterms:description xml:lang="en">Ontology that describes the elements associated with waste management, including facilities, containers and collection points.</dcterms:description>
        <dcterms:description xml:lang="es">Ontología que describe los elementos asociados a la gestión de residuos, incluyendo centros, contenedores y puntos limpios.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</dcterms:modified>
        <dcterms:publisher>
            <rdf:Description>
                <foaf:homepage rdf:resource="https://www.femp.es/"/>
                <foaf:name>FEMP</foaf:name>
                <schema:affiliation>Federación Española de Municipios y Provincias</schema:affiliation>
            </rdf:Description>
        </dcterms:publisher>
        <dcterms:title xml:lang="en">EDINT Waste Management Ontology</dcterms:title>
        <dcterms:title xml:lang="es">Ontología EDINT de Gestión de Residuos</dcterms:title>
        <vann:preferredNamespacePrefix>edintres</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/gestion-residuos#"/>
        <rdfs:label xml:lang="es">Gestión de Residuos</rdfs:label>
        <rdfs:label xml:lang="en">Waste Management</rdfs:label>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-gestion-residuos/releases/tag/v0.1.0"/>
        <owl:versionInfo>0.1.1</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-gestion-residuos"/>
        <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
        <widoco:jsonldSerialization>ontology.jsonld</widoco:jsonldSerialization>
        <widoco:ntSerialization>ontology.nt</widoco:ntSerialization>
        <widoco:rdfxmlSerialization>ontology.rdf</widoco:rdfxmlSerialization>
        <widoco:turtleSerialization>ontology.ttl</widoco:turtleSerialization>
        <widoco:vocabularyLabel>
            <rdf:Description>
                <rdfs:label xml:lang="es">Dirección Postal (esdir)</rdfs:label>
                <rdfs:label xml:lang="en">Postal Address (esdir)</rdfs:label>
                <widoco:vocabularyIRI rdf:resource="https://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal"/>
            </rdf:Description>
        </widoco:vocabularyLabel>
        <widoco:vocabularyLabel>
            <rdf:Description>
                <rdfs:label xml:lang="es">Territorio (esadm)</rdfs:label>
                <rdfs:label xml:lang="en">Territory (esadm)</rdfs:label>
                <widoco:vocabularyIRI rdf:resource="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
            </rdf:Description>
        </widoco:vocabularyLabel>
        <widoco:vocabularyLabel>
            <rdf:Description>
                <rdfs:label xml:lang="en">GeoSPARQL</rdfs:label>
                <rdfs:label xml:lang="es">GeoSPARQL</rdfs:label>
                <widoco:vocabularyIRI rdf:resource="http://www.opengis.net/ont/geosparql"/>
            </rdf:Description>
        </widoco:vocabularyLabel>
        <widoco:vocabularyLabel>
            <rdf:Description>
                <rdfs:label xml:lang="es">Infraestructura (edintinf)</rdfs:label>
                <rdfs:label xml:lang="en">Infrastructure (edintinf)</rdfs:label>
                <widoco:vocabularyIRI rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura"/>
            </rdf:Description>
        </widoco:vocabularyLabel>
    </owl:Ontology>
    


