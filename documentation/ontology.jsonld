  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Es una instalación donde se recogen y almacenan temporalmente y de forma gratuita los residuos domésticos que, por su gran volumen o peligrosidad, no deben arrojarse a la bolsa de la basura ni depositarse en los contenedores de la calle."
  }, {
    "@language" : "en",
    "@value" : "It is a facility where household waste is collected and temporarily stored free of charge—waste that, due to its large volume or hazardous nature, should not be thrown into regular trash bags or deposited in street-side bins."
  }, {
    "@language" : "de",
    "@value" : "Punto limpio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Collection Point"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/gestion-residuos#WasteFacility"
  } ]
}, {
  "@id" : "https://edint.es/def/gestion-residuos#MobileCollectionPoint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Mobile Collection Point"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/gestion-residuos#CollectionPoint"
  } ]
}, {
