  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Permanent Collection Point"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/gestion-residuos#CollectionPoint"
  } ]
}, {
  "@id" : "https://edint.es/def/gestion-residuos#WasteContainer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Contenedor de residuos"
  }, {
    "@language" : "es",
    "@value" : "Es un recipiente usado para almacenamiento temporal de basuras que está normalmente hecho de metal o plástico."
  }, {
    "@language" : "en",
    "@value" : "It is a container used for the temporary storage of waste, typically made of metal or plastic."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Waste Container"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/gestion-residuos#WasteFacility"
  } ]
}, {
  "@id" : "https://edint.es/def/gestion-residuos#WasteFacility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A facility intended for the collection, treatment, transport, or storage of garbage and other waste."
  }, {
    "@language" : "es",
    "@value" : "Equipamiento destinado a la  recogida, tratamiento, transporte o almacenamiento de la basura y otros desechos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Equipamiento de Residuos"
  }, {
    "@language" : "en",
    "@value" : "Waste Facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  }, {
    "@id" : "https://edint.es/def/infraestructura#Facility"
  } ]
}, {
  "@id" : "https://edint.es/def/gestion-residuos#WasteManagementFacility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A designated site or structure equipped to handle, process, treat, store, or dispose of various types of waste. For example, a landfill or a recycling and processing center."
  }, {
    "@language" : "es",
    "@value" : "Equipamiento para la gestión de residuos"
  }, {
    "@language" : "es",
    "@value" : "Un sitio o estructura designada y equipada para gestionar, procesar, tratar, almacenar o eliminar diversos tipos de residuos. Por ejemplo, un vertedero o un centro de reciclaje y procesamiento."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Waste Management Facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/gestion-residuos#WasteFacility"
  } ]
