  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A set of physical, chemical, or biological operations designed to modify the characteristics of waste in order to reduce its hazardousness, recover the materials it contains, or facilitate its safe disposal."
  }, {
    "@language" : "es",
    "@value" : "Conjunto de operaciones físicas, químicas o biológicas destinadas a modificar las características de los desechos para reducir su peligrosidad, aprovechar los materiales que contienen o facilitar su eliminación segura."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/gestion-residuos#WasteManagementFacility"
