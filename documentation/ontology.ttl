#    Data properties
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :CollectionPoint ;
                                      rdfs:range xsd:string ;
                                      rdfs:label "identifier" .


###  http://www.opengis.net/ont/geosparql#asWKT
<http://www.opengis.net/ont/geosparql#asWKT> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://www.opengis.net/ont/geosparql#Geometry> ;
                                             rdfs:range <http://www.opengis.net/ont/geosparql#wktLiteral> ;
                                             rdfs:label "as wkt" .


###  https://edint.es/def/gestion-residuos#admissibleWasteURL
:admissibleWasteURL rdf:type owl:DatatypeProperty ;
                    rdfs:domain :MobileCollectionPoint ;
                    rdfs:range xsd:anyURI ;
                    rdfs:label "admissible waste url" .


###  https://edint.es/def/gestion-residuos#containerBatch
:containerBatch rdf:type owl:DatatypeProperty ;
                rdfs:domain :WasteContainer ;
                rdfs:range xsd:int ;
                rdfs:label "container batch" .


###  https://edint.es/def/gestion-residuos#containerLocationCode
:containerLocationCode rdf:type owl:DatatypeProperty ;
                       rdfs:domain :WasteContainer ;
                       rdfs:range xsd:string ;
                       rdfs:label "container location code" .


###  https://edint.es/def/gestion-residuos#containerType
:containerType rdf:type owl:DatatypeProperty ;
               rdfs:domain :WasteContainer ;
               rdfs:range xsd:string ;
               rdfs:label "container type" .


###  https://edint.es/def/gestion-residuos#isConstructionDemolitionWasteManager
:isConstructionDemolitionWasteManager rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :WasteManagementFacility ;
                                      rdfs:range xsd:boolean ;
                                      rdfs:label "is construction demolition waste manager" .


###  https://edint.es/def/gestion-residuos#isPubliclyOwned
:isPubliclyOwned rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CollectionPoint ;
                 rdfs:range xsd:boolean ;
                 rdfs:label "is publicly owned" .


###  https://edint.es/def/gestion-residuos#loadingType
:loadingType rdf:type owl:DatatypeProperty ;
             rdfs:domain :WasteContainer ;
             rdfs:range xsd:string ;
             rdfs:label "loading type" .


###  https://edint.es/def/gestion-residuos#nif
:nif rdf:type owl:DatatypeProperty ;
     rdfs:domain :WasteManagementFacility ;
     rdfs:range xsd:string ;
     rdfs:label "nif" .


###  https://edint.es/def/gestion-residuos#nima
:nima rdf:type owl:DatatypeProperty ;
      rdfs:domain :WasteManagementFacility ;
      rdfs:range xsd:string ;
      rdfs:label "nima" .


###  https://edint.es/def/gestion-residuos#order
:order rdf:type owl:DatatypeProperty ;
       rdfs:domain :WasteContainer ;
       rdfs:range xsd:int ;
       rdfs:label "order" .


###  https://edint.es/def/gestion-residuos#registrationNumber
:registrationNumber rdf:type owl:DatatypeProperty ;
                    rdfs:domain :WasteManagementFacility ;
                    rdfs:range xsd:string ;
                    rdfs:label "registration number" .


###  https://edint.es/def/gestion-residuos#registrationType
:registrationType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :WasteManagementFacility ;
                  rdfs:range xsd:string ;
                  rdfs:label "registration type" .


###  https://schema.org/dateCreated
<https://schema.org/dateCreated> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :CollectionPoint ;
                                 rdfs:range xsd:dateTime ;
                                 rdfs:label "date created" .


###  https://schema.org/dateModified
<https://schema.org/dateModified> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain :CollectionPoint ;
                                  rdfs:range xsd:dateTime ;
                                  rdfs:label "date modified" .


###  https://schema.org/description
<https://schema.org/description> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :CollectionPoint ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "description" .


###  https://schema.org/faxNumber
<https://schema.org/faxNumber> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://schema.org/ContactPoint> ;
                               rdfs:range xsd:string ;
                               rdfs:label "fax number" .


###  https://schema.org/legalName
<https://schema.org/legalName> rdf:type owl:DatatypeProperty ;
                               rdfs:domain :WasteManagementFacility ;
                               rdfs:range xsd:string ;
                               rdfs:label "legal name" .


###  https://schema.org/map
<https://schema.org/map> rdf:type owl:DatatypeProperty ;
                         rdfs:domain :MobileCollectionPoint ;
                         rdfs:range xsd:anyURI ;
                         rdfs:label "map" .


###  https://schema.org/model
<https://schema.org/model> rdf:type owl:DatatypeProperty ;
                           rdfs:domain :WasteContainer ;
                           rdfs:range xsd:string ;
                           rdfs:label "model" .


###  https://schema.org/name
<https://schema.org/name> rdf:type owl:DatatypeProperty ;
                          rdfs:domain :CollectionPoint ;
                          rdfs:range xsd:string ;
                          rdfs:label "name" .


###  https://schema.org/openingHours
<https://schema.org/openingHours> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain :CollectionPoint ;
                                  rdfs:range xsd:string ;
                                  rdfs:label "opening hours" .


###  https://schema.org/telephone
<https://schema.org/telephone> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://schema.org/ContactPoint> ;
                               rdfs:range xsd:string ;
                               rdfs:label "telephone" .


