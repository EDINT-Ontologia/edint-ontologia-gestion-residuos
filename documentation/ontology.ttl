###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#Facility
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#Facility> rdf:type owl:Class ;
                                                                                                   rdfs:label "Facility" .


###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ;
                                               rdfs:label "Feature" .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                rdfs:label "Geometry" .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:label "Concept" .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class ;
                                                    rdfs:label "Concept Scheme" .


###  https://edint.es/def/gestion-residuos#CollectionPoint
:CollectionPoint rdf:type owl:Class ;
                 rdfs:subClassOf :WasteFacility ;
                 rdfs:label "Collection Point" .


###  https://edint.es/def/gestion-residuos#MobileCollectionPoint
:MobileCollectionPoint rdf:type owl:Class ;
                       rdfs:subClassOf :CollectionPoint ;
                       rdfs:label "Mobile Collection Point" .


###  https://edint.es/def/gestion-residuos#PermanentCollectionPoint
:PermanentCollectionPoint rdf:type owl:Class ;
                          rdfs:subClassOf :CollectionPoint ;
                          rdfs:label "Permanent Collection Point" .


###  https://edint.es/def/gestion-residuos#WasteContainer
:WasteContainer rdf:type owl:Class ;
                rdfs:subClassOf :WasteFacility ;
                rdfs:label "Waste Container" .


###  https://edint.es/def/gestion-residuos#WasteFacility
:WasteFacility rdf:type owl:Class ;
               rdfs:subClassOf <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#Facility> ,
                               <http://www.opengis.net/ont/geosparql#Feature> ;
               rdfs:label "Waste Facility" .


###  https://edint.es/def/gestion-residuos#WasteManagementFacility
:WasteManagementFacility rdf:type owl:Class ;
                         rdfs:subClassOf :WasteFacility ;
                         rdfs:label "Waste Management Facility" .


###  https://schema.org/ContactPoint
<https://schema.org/ContactPoint> rdf:type owl:Class ;
                                  rdfs:label "Contact Point" .


