@prefix : <https://edint.es/def/gestion-residuos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://edint.es/def/gestion-residuos#> .

<https://edint.es/def/gestion-residuos#> rdf:type owl:Ontology ;
                                          owl:versionIRI <https://edint.es/def/gestion-residuos/0.1.1> ;
                                          <http://purl.org/dc/terms/abstract> "El propósito de esta ontología es el de proporcionar un vocabulario común para la representación de los elementos asociados a la gestión de residuos, incluyendo su tipología, su depósito en contenedores y puntos de recogida, su tratamiento en instalaciones y su localización. Su alcance se limita a los datos de carácter administrativo y estructural: quedan fuera del modelo los aspectos relativos a la gestión operativa o al funcionamiento detallado de los servicios, que podrían ser incorporados en futuras extensiones de la ontología."@es ,
                                                                              "The purpose of this ontology is to provide a common vocabulary for representing the elements associated with waste management, including waste types, their deposit in containers and collection points, their treatment in facilities and their location. Its scope is limited to administrative and structural data; aspects related to operational management or the detailed operation of the services fall outside the model, although they could be addressed through future extensions of the ontology."@en ;
                                          <http://purl.org/dc/terms/bibliographicCitation> "EDINT Waste Management Ontology. EDINT. Revision: v0.1.1."@en ,
                                                                                           "Ontología EDINT de Gestión de Residuos. EDINT. Revisión: v0.1.1."@es ;
                                          <http://purl.org/dc/terms/created> "2026-04-01"^^xsd:date ;
                                          <http://purl.org/dc/terms/creator> _:genid1 ;
                                          <http://purl.org/dc/terms/description> "Ontology that describes the elements associated with waste management, including facilities, containers and collection points."@en ,
                                                                                 "Ontología que describe los elementos asociados a la gestión de residuos, incluyendo centros, contenedores y puntos limpios."@es ;
                                          <http://purl.org/dc/terms/issued> "2026-09-17"^^xsd:date ;
                                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                          <http://purl.org/dc/terms/modified> "2026-09-17"^^xsd:date ;
                                          <http://purl.org/dc/terms/publisher> _:genid2 ;
                                          <http://purl.org/dc/terms/title> "EDINT Waste Management Ontology"@en ,
                                                                           "Ontología EDINT de Gestión de Residuos"@es ;
                                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintres" ;
                                          <http://purl.org/vocab/vann/preferredNamespaceUri> <https://edint.es/def/gestion-residuos#> ;
                                          rdfs:label "Gestión de Residuos"@es ,
                                                     "Waste Management"@en ;
                                          owl:priorVersion <https://github.com/EDINT-Ontologia/edint-ontologia-gestion-residuos/releases/tag/v0.1.0> ;
                                          owl:versionInfo "0.1.1" ;
                                          <https://schema.org/codeRepository> <https://github.com/EDINT-Ontologia/edint-ontologia-gestion-residuos> ;
                                          <https://schema.org/creativeWorkStatus> "Ontology Specification"@en ;
                                          <https://schema.org/funding> "Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)" ;
                                          <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/> ;
                                          <https://w3id.org/widoco/vocab#jsonldSerialization> "ontology.jsonld" ;
                                          <https://w3id.org/widoco/vocab#ntSerialization> "ontology.nt" ;
                                          <https://w3id.org/widoco/vocab#rdfxmlSerialization> "ontology.rdf" ;
                                          <https://w3id.org/widoco/vocab#turtleSerialization> "ontology.ttl" ;
                                          <https://w3id.org/widoco/vocab#vocabularyLabel> _:genid3 ,
                                                                                          _:genid4 ,
                                                                                          _:genid5 ,
                                                                                          _:genid6 .

_:genid1 <http://xmlns.com/foaf/0.1/name> "Laura Gilgado Romero" ;
          <https://schema.org/affiliation> <https://oeg.fi.upm.es/> .

_:genid2 <http://xmlns.com/foaf/0.1/homepage> <https://www.femp.es/> ;
          <http://xmlns.com/foaf/0.1/name> "FEMP" ;
          <https://schema.org/affiliation> "Federación Española de Municipios y Provincias" .

_:genid3 rdfs:label "Infraestructura (edintinf)"@es ,
                     "Infrastructure (edintinf)"@en ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura> .

_:genid4 rdfs:label "GeoSPARQL"@en ,
                     "GeoSPARQL"@es ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <http://www.opengis.net/ont/geosparql> .

_:genid5 rdfs:label "Territorio (esadm)"@es ,
                     "Territory (esadm)"@en ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> .

_:genid6 rdfs:label "Dirección Postal (esdir)"@es ,
                     "Postal Address (esdir)"@en ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <https://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal> .

