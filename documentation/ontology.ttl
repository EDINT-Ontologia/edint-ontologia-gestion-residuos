xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.opengis.net/ont/geosparql#hasGeometry
<http://www.opengis.net/ont/geosparql#hasGeometry> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.opengis.net/ont/geosparql#Feature> ;
                                                   rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                                                   rdfs:label "has geometry" .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept> ;
                                               rdfs:range <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                               rdfs:label "in scheme" .


###  https://edint.es/def/gestion-residuos#acceptsWasteType
:acceptsWasteType rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :CollectionPoint
                                              :WasteContainer
                                            )
                              ] ;
                  rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                      owl:hasValue <https://edint.es/kos/WasteType>
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
                  rdfs:comment "A container or a collection point accepts specific types of waste."@en ,
                               "Un contenedor o un punto limpio aceptan determinados tipos de residuos."@es ;
                  rdfs:label "accepts waste type"@en ,
                             "acepta tipo de residuo"@es .


###  https://edint.es/def/gestion-residuos#belongsTo
:belongsTo rdf:type owl:ObjectProperty ;
           rdfs:domain :WasteFacility ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio>
                                      <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito>
                                      <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>
                                    )
                      ] ;
           rdfs:comment "A waste management facility belongs to a neighborhood, district, or municipality."@en ,
                        "Un equipamiento para residuos pertenece a un barrio, distrito o municipio."@es ;
           rdfs:label "belongs to"@en ,
                      "pertenece a"@es .


###  https://edint.es/def/gestion-residuos#hasManagementScope
:hasManagementScope rdf:type owl:ObjectProperty ;
                    rdfs:domain :WasteManagementFacility ;
                    rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                        owl:hasValue <https://edint.es/kos/WasteManagementScope>
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
                    rdfs:comment "Alcance de gestión asociados a centros de gestión de residuos, por ejemplo el almacenamiento de residuos metálicos de plomo."@es ,
                                 "Management scope associated with waste management facilities, for example, the storage of lead-based metal waste."@en ;
                    rdfs:label "has management scope"@en ,
                               "tiene ámbito de gestión"@es .


###  https://edint.es/def/gestion-residuos#hasTreatmentProcess
:hasTreatmentProcess rdf:type owl:ObjectProperty ;
                     rdfs:domain :WasteManagementFacility ;
                     rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                         owl:hasValue <https://edint.es/kos/WasteTreatmentProcess>
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                     rdfs:comment "A set of physical, chemical, or biological operations designed to modify the characteristics of waste in order to reduce its hazardousness, recover the materials it contains, or facilitate its safe disposal."@en ,
                                  "Conjunto de operaciones físicas, químicas o biológicas destinadas a modificar las características de los desechos para reducir su peligrosidad, aprovechar los materiales que contienen o facilitar su eliminación segura."@es ;
                     rdfs:label "has treatment process"@en ,
                                "tiene proceso de tratamiento"@es .


###  https://edint.es/def/gestion-residuos#managesWasteType
:managesWasteType rdf:type owl:ObjectProperty ;
                  rdfs:domain :WasteManagementFacility ;
                  rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                      owl:hasValue <https://edint.es/kos/WasteType>
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
                  rdfs:comment "Relación entre el equipamiento para gestión de residuos y el tipo de residuos que gestiona."@es ,
                               "Relationship between waste management equipment and the type of waste managed."@en ,
                               "gestiona tipo de residuo"@es ;
                  rdfs:label "manages waste type"@en .


###  https://schema.org/address
<https://schema.org/address> rdf:type owl:ObjectProperty ;
                             rdfs:domain :WasteFacility ;
                             rdfs:range <https://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> ;
                             rdfs:label "address" .


###  https://schema.org/contactPoint
<https://schema.org/contactPoint> rdf:type owl:ObjectProperty ;
                                  rdfs:domain [ rdf:type owl:Class ;
                                                owl:unionOf ( :CollectionPoint
                                                              :WasteManagementFacility
                                                            )
                                              ] ;
                                  rdfs:range <https://schema.org/ContactPoint> ;
                                  rdfs:label "contact point" .


###  https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAProvincia
<https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAProvincia> rdf:type owl:ObjectProperty ;
                                                                                              rdfs:domain <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> ;
                                                                                              rdfs:range <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia> ;
                                                                                              rdfs:label "pertenece a provincia" .


###  https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAlMunicipio
<https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#perteneceAlMunicipio> rdf:type owl:ObjectProperty ;
                                                                                               rdfs:domain [ rdf:type owl:Class ;
                                                                                                             owl:unionOf ( <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio>
                                                                                                                           <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito>
                                                                                                                         )
                                                                                                           ] ;
                                                                                               rdfs:range <https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> ;
                                                                                               rdfs:label "pertenece al municipio" .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :CollectionPoint ;
                                      rdfs:range xsd:string ;
                                      rdfs:label "identifier"@en .


###  http://www.opengis.net/ont/geosparql#asWKT
<http://www.opengis.net/ont/geosparql#asWKT> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://www.opengis.net/ont/geosparql#Geometry> ;
                                             rdfs:range <http://www.opengis.net/ont/geosparql#wktLiteral> ;
                                             rdfs:label "as wkt" .


###  https://edint.es/def/gestion-residuos#admissibleWasteURL
:admissibleWasteURL rdf:type owl:DatatypeProperty ;
                    rdfs:domain :MobileCollectionPoint ;
                    rdfs:range xsd:anyURI ;
                    rdfs:label "URL de residuos admisibles."@en ,
                               "admissible waste url"@en .


###  https://edint.es/def/gestion-residuos#containerBatch
:containerBatch rdf:type owl:DatatypeProperty ;
                rdfs:domain :WasteContainer ;
                rdfs:range xsd:int ;
                rdfs:comment "A specific, grouped quantity of waste units."@en ,
                             "Una cantidad específica y agrupada de unidades de residuos."@es ;
                rdfs:label "container batch"@en ,
                           "grupo de contenedores"@es .


###  https://edint.es/def/gestion-residuos#containerLocationCode
:containerLocationCode rdf:type owl:DatatypeProperty ;
                       rdfs:domain :WasteContainer ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Identificador específico utilizado en los sistemas de gestión de residuos."@es ,
                                    "Specific identifier used in waste management systems."@en ;
                       rdfs:label "container location code"@en ,
                                  "código de ubicación del contenedor."@es .


###  https://edint.es/def/gestion-residuos#containerType
:containerType rdf:type owl:DatatypeProperty ;
               rdfs:domain :WasteContainer ;
               rdfs:range xsd:string ;
               rdfs:label "container type"@en ,
                          "tipo de contenedor"@es .


###  https://edint.es/def/gestion-residuos#isConstructionDemolitionWasteManager
:isConstructionDemolitionWasteManager rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :WasteManagementFacility ;
                                      rdfs:range xsd:boolean ;
                                      rdfs:label "es gestor de residuos de demolición de construcción"@es ,
                                                 "is construction demolition waste manager"@en .


###  https://edint.es/def/gestion-residuos#isPubliclyOwned
:isPubliclyOwned rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CollectionPoint ;
                 rdfs:range xsd:boolean ;
                 rdfs:label "es de propiedad pública"@es ,
                            "is publicly owned"@en .


###  https://edint.es/def/gestion-residuos#loadingType
:loadingType rdf:type owl:DatatypeProperty ;
             rdfs:domain :WasteContainer ;
             rdfs:range xsd:string ;
             rdfs:label "loading type"@en ,
                        "tipo de carga"@es .


###  https://edint.es/def/gestion-residuos#nif
:nif rdf:type owl:DatatypeProperty ;
     rdfs:domain :WasteManagementFacility ;
     rdfs:range xsd:string ;
     rdfs:label "Número de identificación fiscal (NIF)"@es ,
                "Tax Identification Number (NIF)"@en .


###  https://edint.es/def/gestion-residuos#nima
:nima rdf:type owl:DatatypeProperty ;
      rdfs:domain :WasteManagementFacility ;
      rdfs:range xsd:string ;
      rdfs:label "Environmental Identification Number (NIMA)"@en ,
                 "Número de Identificación Medioambiental (NIMA)"@es .


###  https://edint.es/def/gestion-residuos#order
:order rdf:type owl:DatatypeProperty ;
       rdfs:domain :WasteContainer ;
       rdfs:range xsd:int ;
       rdfs:label "orden"@es ,
                  "order"@en .


###  https://edint.es/def/gestion-residuos#registrationNumber
:registrationNumber rdf:type owl:DatatypeProperty ;
                    rdfs:domain :WasteManagementFacility ;
                    rdfs:range xsd:string ;
                    rdfs:label "número de registro"@es ,
                               "registration number"@en .


###  https://edint.es/def/gestion-residuos#registrationType
:registrationType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :WasteManagementFacility ;
                  rdfs:range xsd:string ;
                  rdfs:label "registration type"@en ,
                             "tipo de registro"@es .


###  https://schema.org/dateCreated
<https://schema.org/dateCreated> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :CollectionPoint ;
                                 rdfs:range xsd:dateTime ;
                                 rdfs:label "date created" .


###  https://schema.org/dateModified
<https://schema.org/dateModified> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain :CollectionPoint ;
                                  rdfs:range xsd:dateTime ;
                                  rdfs:label "date modified" .


###  https://schema.org/description
<https://schema.org/description> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :CollectionPoint ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "description" .


###  https://schema.org/faxNumber
<https://schema.org/faxNumber> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://schema.org/ContactPoint> ;
                               rdfs:range xsd:string ;
                               rdfs:label "fax number" .


###  https://schema.org/legalName
<https://schema.org/legalName> rdf:type owl:DatatypeProperty ;
                               rdfs:domain :WasteManagementFacility ;
                               rdfs:range xsd:string ;
                               rdfs:label "legal name" .


###  https://schema.org/map
<https://schema.org/map> rdf:type owl:DatatypeProperty ;
                         rdfs:domain :MobileCollectionPoint ;
                         rdfs:range xsd:anyURI ;
                         rdfs:label "map" .


###  https://schema.org/model
<https://schema.org/model> rdf:type owl:DatatypeProperty ;
                           rdfs:domain :WasteContainer ;
                           rdfs:range xsd:string ;
                           rdfs:label "model" .


###  https://schema.org/name
<https://schema.org/name> rdf:type owl:DatatypeProperty ;
                          rdfs:domain :CollectionPoint ;
                          rdfs:range xsd:string ;
                          rdfs:label "name" .


###  https://schema.org/openingHours
<https://schema.org/openingHours> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain :CollectionPoint ;
                                  rdfs:range xsd:string ;
                                  rdfs:label "opening hours" .


###  https://schema.org/telephone
<https://schema.org/telephone> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://schema.org/ContactPoint> ;
                               rdfs:range xsd:string ;
                               rdfs:label "telephone" .


#################################################################
#    Classes
#################################################################

###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ;
                                               rdfs:label "Feature" .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                rdfs:label "Geometry" .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:label "Concept" .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
