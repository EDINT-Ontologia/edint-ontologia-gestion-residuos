###  https://edint.es/def/gestion-residuos#CollectionPoint
:CollectionPoint rdf:type owl:Class ;
                 rdfs:subClassOf :WasteFacility ;
                 rdfs:comment "Es una instalación donde se recogen y almacenan temporalmente y de forma gratuita los residuos domésticos que, por su gran volumen o peligrosidad, no deben arrojarse a la bolsa de la basura ni depositarse en los contenedores de la calle."@es ,
                              "It is a facility where household waste is collected and temporarily stored free of charge—waste that, due to its large volume or hazardous nature, should not be thrown into regular trash bags or deposited in street-side bins."@en ,
                              "Punto limpio"@de ;
                 rdfs:label "Collection Point"@en .


###  https://edint.es/def/gestion-residuos#MobileCollectionPoint
:MobileCollectionPoint rdf:type owl:Class ;
                       rdfs:subClassOf :CollectionPoint ;
                       rdfs:label "Mobile Collection Point" .


###  https://edint.es/def/gestion-residuos#PermanentCollectionPoint
:PermanentCollectionPoint rdf:type owl:Class ;
                          rdfs:subClassOf :CollectionPoint ;
                          rdfs:label "Permanent Collection Point" .


###  https://edint.es/def/gestion-residuos#WasteContainer
:WasteContainer rdf:type owl:Class ;
                rdfs:subClassOf :WasteFacility ;
                rdfs:comment "Contenedor de residuos"@es ,
                             "Es un recipiente usado para almacenamiento temporal de basuras que está normalmente hecho de metal o plástico."@es ,
                             "It is a container used for the temporary storage of waste, typically made of metal or plastic."@en ;
                rdfs:label "Waste Container"@en .


###  https://edint.es/def/gestion-residuos#WasteFacility
:WasteFacility rdf:type owl:Class ;
               rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                               <https://edint.es/def/infraestructura#Facility> ;
               rdfs:comment "A facility intended for the collection, treatment, transport, or storage of garbage and other waste."@en ,
                            "Equipamiento destinado a la  recogida, tratamiento, transporte o almacenamiento de la basura y otros desechos."@es ;
               rdfs:label "Equipamiento de Residuos"@es ,
                          "Waste Facility"@en .


###  https://edint.es/def/gestion-residuos#WasteManagementFacility
:WasteManagementFacility rdf:type owl:Class ;
                         rdfs:subClassOf :WasteFacility ;
                         rdfs:comment "A designated site or structure equipped to handle, process, treat, store, or dispose of various types of waste. For example, a landfill or a recycling and processing center."@en ,
                                      "Equipamiento para la gestión de residuos"@es ,
                                      "Un sitio o estructura designada y equipada para gestionar, procesar, tratar, almacenar o eliminar diversos tipos de residuos. Por ejemplo, un vertedero o un centro de reciclaje y procesamiento."@es ;
                         rdfs:label "Waste Management Facility"@en .


