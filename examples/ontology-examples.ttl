ex:permanentCollectionPoint2503
  a edintres:PermanentCollectionPoint ;
  dcterms:identifier "2503" ;
  gsp:hasGeometry ex:geometryPermanentCollectionPoint2503 ;
  schema:address ex:addressPermanentCollectionPoint2503 ;
  schema:contactPoint ex:contactPointPermanentCollectionPoint2503 ;
  schema:dateCreated "2008-01-10T02:00:00Z"^^xsd:dateTime ;
  schema:dateModified "2023-09-26T14:48:30Z"^^xsd:dateTime ;
  schema:description """¿CÓMO UTILIZAREMOS EL PUNTO LIMPIO? Para poder utilizar el punto limpio habrá que tener en cuenta varios aspectos:
• Solo se admitirán residuos generados por particulares.
• No se podrán verter residuos peligrosos. Solo se recogerán las pilas usadas.
• El usuario si va a depositar más de un residuo lo deberá hacer por separado para poder depositarlo en su contenedor correspondiente.
• Se deberá cumplimentar el documento que nos facilitará el operario.
Una vez se haya llegado al punto limpio un operario informará en que contenedor se debe depositar los residuos. Se puede acceder tanto a pie como en el vehículo particular (que no debe exceder de 3500 kg. de tara) y cómodamente situarse junto al contenedor marcado con el nombre del residuo a verter.""" ;
  schema:name "Punto limpio fijo Cogullada" ;
  schema:openingHours "De lunes a sábado (incluso festivos) de 7:30 a 20:30 h. Domingos de 8:00 a 14:30 h." ;
  edintres:belongsTo ex:distritoElRabal ;
  edintres:isPubliclyOwned true .

ex:provinciaMadrid
  a esadm:Provincia ;
  rdfs:label "Madrid"@es .

