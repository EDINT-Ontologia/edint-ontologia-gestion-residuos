  edintres:acceptsWasteType wastetype:PlasticosMetalesYBriks ;
  edintres:belongsTo ex:barrioCortes ;
  edintres:belongsTo ex:distritoCentro ;
  edintres:containerBatch 1 ;
  edintres:containerLocationCode "CS_013_016" ;
  edintres:loadingType "Carga superior" ;
  edintres:order 20270 .

