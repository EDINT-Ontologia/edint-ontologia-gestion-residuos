<https://edint.es/def/gestion-residuos#mobileCollectionPointCalleCobre>
  a edintres:MobileCollectionPoint ;
  rdfs:label "Punto limpio móvil"@es ,
             "Mobile collection point"@en ;
  gsp:hasGeometry edintres:geometryMobileCollectionPointCalleCobre ;
  schema:address edintres:addressMobileCollectionPointCalleCobre ;
  schema:map "https://goo.gl/maps/mJnrT377bHTyQduM7"^^xsd:anyURI ;
  schema:openingHours "Martes. Tarde. 17:30:00. 19:00:00" ;
  edintres:admissibleWasteURL "http://run.gob.es/PuntoMOVILResiduos"^^xsd:anyURI ;
  edintres:belongsTo edintres:distritoArganzuela .

