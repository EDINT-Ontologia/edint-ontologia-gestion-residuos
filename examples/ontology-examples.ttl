<https://edint.es/def/gestion-residuos#permanentCollectionPoint2503>
  a edintres:PermanentCollectionPoint ;
  rdfs:label "Punto limpio fijo"@es ,
             "Fixed collection point"@en ;
  dcterms:identifier "2503" ;
  gsp:hasGeometry edintres:geometryPermanentCollectionPoint2503 ;
  schema:address edintres:addressPermanentCollectionPoint2503 ;
  schema:contactPoint edintres:contactPointPermanentCollectionPoint2503 ;
  schema:dateCreated "2008-01-10T02:00:00Z"^^xsd:dateTime ;
  schema:dateModified "2023-09-26T14:48:30Z"^^xsd:dateTime ;
  schema:description """¿CÓMO UTILIZAREMOS EL PUNTO LIMPIO? 
    												  Para poder utilizar el punto limpio habrá que tener en cuenta varios aspectos:
													  • Solo se admitirán residuos generados por particulares.
												      • No se podrán verter residuos peligrosos. Solo se recogerán las pilas usadas.
													  • El usuario si va a depositar más de un residuo lo deberá hacer por separado para poder depositarlo en su contenedor correspondiente.
													  • Se deberá cumplimentar el documento que nos facilitará el operario.
												      Una vez se haya llegado al punto limpio un operario informará en que contenedor se debe depositar los residuos. Se puede acceder tanto a pie como en el vehículo particular (que no debe exceder de 3500 kg. de tara) y cómodamente situarse junto al contenedor marcado con el nombre del residuo a verter.""" ;
  schema:name "Punto limpio fijo Cogullada" ;
  schema:openingHours "De lunes a sábado (incluso festivos) de 7:30 a 20:30 h. Domingos de 8:00 a 14:30 h." ;
  edintres:belongsTo edintres:distritoElRabal ;
  edintres:isPubliclyOwned true .

<https://edint.es/def/gestion-residuos#provinciaMadrid>
  a esadm:Provincia ;
  rdfs:label "Madrid"@es .

<https://edint.es/def/gestion-residuos#wasteContainer20270>
  a edintres:WasteContainer ;
  gsp:hasGeometry edintres:geometryWasteContainer20270 ;
  schema:address edintres:addressWasteContainer20270 ;
  schema:model "E 3100 CS" ;
  edintres:acceptsWasteType wastetype:PlasticosMetalesYBriks ;
  edintres:belongsTo edintres:barrioCortes ;
  edintres:belongsTo edintres:distritoCentro ;
  edintres:containerBatch 1 ;
  edintres:containerLocationCode "CS_013_016" ;
  edintres:loadingType "Carga superior" ;
  edintres:order 20270 .

<https://edint.es/def/gestion-residuos#wasteManagementFacility13G04A1400037921E>
  a edintres:WasteManagementFacility ;
  schema:address edintres:addressWasteManagementFacility13G04A1400037921E ;
  schema:contactPoint edintres:contactPointWasteManagementFacility13G04A1400037921E ;
  schema:legalName "Tecnologías del Medio Ambiente, S.A." ;
  edintres:belongsTo edintres:municipioFuenlabrada ;
  edintres:hasManagementScope managementscope:ClasificacionResiduosNoPeligrososTrituracionMadera ;
  edintres:hasTreatmentProcess treatmentprocess:ClasificacionResiduosNoPeligrosos ;
  edintres:isConstructionDemolitionWasteManager false ;
  edintres:managesWasteType wastetype:ResiduosVoluminosos ;
  edintres:nif "A08948143" ;
  edintres:nima "2800023654" ;
  edintres:registrationNumber "13G04A1400037921E" ;
  edintres:registrationType "Autorización de gestión de residuos no peligrosos" .